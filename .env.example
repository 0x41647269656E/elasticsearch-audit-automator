# Copiez ce fichier en .env et remplacez les valeurs.
# .env est ignoré par git : aucun secret réel ne doit sortir d'ici.
#
# Ces variables ne concernent que main.py et analyse.py. Les conteneurs des
# stacks de test (data-loader, workers) tirent les leurs des docker-compose.yml.

# --- Cible Elasticsearch (collecte, main.py) ---
ELASTIC_HOST=elasticsearch.exemple.local
ELASTIC_PORT=9200
ELASTIC_SCHEME=https
ELASTIC_USERNAME=audit-elasticsearch
ELASTIC_PASSWORD=remplacer-par-le-mot-de-passe
# Alternative à l'authentification par mot de passe ; laisser vide si inutilisé.
ELASTIC_BEARER_TOKEN=

# --- TLS ---
# false uniquement en laboratoire : désactive la validation du certificat.
VERIFY_TLS=true
# Autorité de certification à utiliser pour valider le cluster.
CA_CERT_PATH=/chemin/vers/ca.crt

# --- Identification de l'audit ---
# Sert à nommer le dossier d'audit : data/<horodatage>-<client>-<cluster>.
CLIENT_NAME=acme
# PRODUCTION, PREPROD, RECETTE, DEV ou AUTRE.
# Pondère la sévérité des constats : un index sans replica est CRITIQUE en
# PRODUCTION et seulement INFORMATIF en DEV.
CLUSTER_TYPOLOGY=PRODUCTION

# --- Robustesse ---
# Délai maximal par requête, en secondes. Sans lui, un nœud qui accepte la
# connexion sans répondre bloque l'audit indéfiniment.
REQUEST_TIMEOUT=60

# --- Analyse (analyse.py) ---
# Clé créée sur https://platform.claude.com — facturation distincte d'un
# abonnement Claude. Une variable déjà exportée l'emporte sur ce fichier.
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACER-PAR-VOTRE-CLE

# --- Rebond SSH (facultatif) ---
# Renseigner uniquement si le cluster n'est joignable qu'à travers un rebond.
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_KEY_PATH=
SSH_PASSWORD=
